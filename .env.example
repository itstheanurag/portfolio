# Visitor counter — durable storage in a GitHub Gist (no database)
# Create a secret gist with a visitors.json file, then add these values.
VISITORS_GIST_ID=
VISITORS_GIST_TOKEN=
VISITORS_GIST_FILE=visitors.json

# Optional zero-config fallback (Abacus) if the Gist is not configured
VISITORS_COUNTER_NAMESPACE=itsanurag-portfolio
VISITORS_COUNTER_KEY=visits
